<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Femtocell Management</title>
  <style>
    :root { color-scheme: dark; font-family: system-ui, sans-serif; }
    body { max-width: 1100px; margin: 0 auto; padding: 24px; background: #0e141b; color: #ecf2fa; }
    header { display: flex; justify-content: space-between; align-items: center; gap: 20px; border-bottom: 1px solid #2f3c4d; padding-bottom: 18px; }
    h1 { margin: 0; }
    .muted { color: #9aa9bb; }
    .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 14px; margin: 22px 0; }
    .card { background: #171f2a; border: 1px solid #2f3c4d; border-radius: 10px; padding: 16px; }
    .ok { color: #8ee2a5; }
    code, pre, textarea { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; }
    textarea { width: 100%; min-height: 100px; box-sizing: border-box; padding: 12px; resize: vertical; color: #eaf2ff; background: #080c11; border: 1px solid #53677e; border-radius: 7px; }
    button { padding: 10px 18px; margin-top: 10px; border: 0; border-radius: 7px; color: #fff; background: #2a659a; cursor: pointer; }
    pre { min-height: 180px; white-space: pre-wrap; overflow-wrap: anywhere; padding: 14px; background: #080c11; border-radius: 7px; border: 1px solid #253242; }
    .warning { border-left: 4px solid #d59d49; background: #282216; }
  </style>
</head>
<body>
  <header>
    <div>
      <h1>Femtocell Management</h1>
      <p class="muted">Device ID: FEMTO-042 · firmware 3.8.12</p>
    </div>
    <span class="ok">● S1 link: ready</span>
  </header>

  <div class="grid">
    <section class="card">
      <h2>MME connection</h2>
      <p class="ok">connected</p>
      <p class="muted">management target: hidden</p>
    </section>
    <section class="card">
      <h2>Support link</h2>
      <p class="ok">connected</p>
      <p class="muted">service target: hidden</p>
    </section>
  </div>

  <section class="card">
    <h2>Maintenance console</h2>
    
      <p class="muted">locked · maintenance authorization required</p>
      <a href="/maintenance">Open maintenance interface</a>
    
  </section>
  <p id="backhaul-status" class="muted">Backhaul monitor: checking…</p>
  <script src="/static/dashboard.js" defer></script>
</body>
</html>