<!doctype html>
<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Maintenance authorization</title>
  <style>
    :root { color-scheme: dark; font-family: system-ui, sans-serif; }
    body { max-width: 560px; margin: 80px auto; padding: 24px; background: #0e141b; color: #ecf2fa; }
    .card { background: #171f2a; border: 1px solid #2f3c4d; border-radius: 10px; padding: 22px; }
    input, button { width: 100%; box-sizing: border-box; padding: 11px; margin-top: 8px; border-radius: 6px; border: 1px solid #53677e; background: #080c11; color: inherit; }
    button { background: #2a659a; cursor: pointer; }
    .error { color: #ff9e9e; }
    .muted { color: #9aa9bb; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Maintenance authorization</h1>
    <p class="muted">Enter the active ticket issued by field-support dispatch.</p>
    
    <form method="post">
      <label for="ticket">Maintenance ticket</label>
      <input id="ticket" name="ticket" autocomplete="off" required>
      <button type="submit">Unlock console</button>
    </form>
  </div>
</body>
</html>